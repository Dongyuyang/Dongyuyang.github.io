---
layout: base.njk
isPost: true
pageKey: post
---
{% set t = lang | getLocale %}
<div class="reading-progress" aria-hidden="true"><span id="reading-progress"></span></div>
<article class="post wrap"><header class="post-header"><a class="back-link" href="{{ t.prefix }}blog/">← {{ t.backBlog }}</a><div class="eyebrow">{{ date | readableDate(t.code) }}</div><h1>{{ title }}</h1><p class="post-description">{{ description }}</p><div class="post-byline">Yuyang Dong <span>(David Dong)</span></div><div class="post-views" data-view-count data-unavailable="{{ t.viewCountUnavailable }}"><span>{{ t.viewCountLabel }} <span id="busuanzi_value_page_pv" role="status" aria-live="polite">—</span></span><details class="view-count-info"><summary aria-label="{{ t.viewCountNote }}">ⓘ</summary><p>{{ t.viewCountNote }} <a href="https://busuanzi.ibruce.info/" target="_blank" rel="noopener noreferrer">Busuanzi ↗</a></p></details></div></header><div class="prose" id="article-content">{{ content | safe }}</div><footer class="post-footer"><a class="text-link" href="{{ t.prefix }}blog/">← {{ t.backBlog }}</a><a class="text-link" href="{{ t.prefix }}feed.xml">{{ t.followRSS }} ↗</a></footer></article>
