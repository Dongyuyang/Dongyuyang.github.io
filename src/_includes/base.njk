{% set t = locale or (lang | getLocale) %}
{% set pageTitle = title or t[pageKey] %}
<!doctype html>
<html lang="{{ t.code }}">
<head>
 <meta charset="utf-8">
 <meta name="viewport" content="width=device-width, initial-scale=1">
 <meta name="theme-color" content="#fafaf9">
 <title>{% if pageKey != 'home' and pageTitle %}{{ pageTitle }} — {% endif %}Yuyang Dong (David Dong)</title>
 <meta name="description" content="{{ description or t.description }}">
 <link rel="canonical" href="{{ page.url | absoluteUrl }}">
 {% set alternates = collections.publishedPosts | pageAlternates(pageKey, translationKey) %}
 {% for alt in alternates %}<link rel="alternate" hreflang="{{ alt.code }}" href="{{ alt.url | absoluteUrl }}">{% endfor %}
 {% for alt in alternates %}{% if alt.code == 'en' %}<link rel="alternate" hreflang="x-default" href="{{ alt.url | absoluteUrl }}">{% endif %}{% endfor %}
 <meta property="og:type" content="{% if isPost %}article{% else %}website{% endif %}">
 <meta property="og:title" content="{% if pageKey != 'home' and pageTitle %}{{ pageTitle }} — {% endif %}Yuyang Dong">
 <meta property="og:description" content="{{ description or t.description }}">
 <meta property="og:url" content="{{ page.url | absoluteUrl }}">
 <meta property="og:image" content="{{ (socialImage or '/assets/social-card.png') | absoluteUrl }}">
 <meta name="twitter:card" content="summary_large_image">
 <link rel="icon" href="/assets/personal-avatar.png" type="image/png">
 <link rel="alternate" type="application/rss+xml" title="Yuyang Dong — {{ t.blog }}" href="{{ t.prefix }}feed.xml">
 <link rel="preload" href="/assets/fonts/manrope.ttf" as="font" type="font/ttf" crossorigin>
 <link rel="stylesheet" href="/assets/style.css?v={{ assetVersion }}">
 <script src="/assets/site.js?v={{ assetVersion }}" defer></script>
</head>
<body class="{% if isHome %}home{% endif %}">
<a class="skip-link" href="#main">{{ t.skip }}</a>
<header class="site-header">
 <div class="header-inner wrap">
  <a class="brand" href="{{ t.prefix }}" aria-label="Yuyang Dong — {{ t.home }}"><img class="brand-avatar" src="/assets/personal-avatar.png" alt="" width="40" height="40"><span>Yuyang Dong<span class="brand-alias"> (David Dong)</span></span></a>
  <nav id="main-nav" aria-label="{{ t.navigation }}">
   <a href="{{ t.prefix }}#research">{{ t.research }}</a>
   <a href="{{ t.prefix }}#vision">{{ t.vision }}</a>
   <a href="{{ t.prefix }}publications/"{% if pageKey == 'publications' %} aria-current="page"{% endif %}>{{ t.publications }}</a>
   <a href="{{ t.prefix }}blog/"{% if pageKey == 'blog' or isPost %} aria-current="page"{% endif %}>{{ t.blog }}</a>
   <a href="{{ t.prefix }}#about">{{ t.about }}</a>
  </nav>
  <nav class="language-switch" aria-label="{{ t.switchLanguage }}">
  {% for code in ['ja','zh','en'] %}{% for alt in alternates %}{% if alt.code == code %}<a href="{{ alt.url }}" lang="{{ alt.code }}" hreflang="{{ alt.code }}" data-locale-link{% if alt.code == t.code %} aria-current="true"{% endif %}>{{ alt.language }}</a>{% endif %}{% endfor %}{% endfor %}
  </nav>
  <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">{{ t.menu }} <span aria-hidden="true">+</span></button>
 </div>
</header>
<main id="main">{{ content | safe }}</main>
<footer class="site-footer wrap">
 <div><a class="footer-name" href="{{ t.prefix }}">Yuyang Dong <span>(David Dong)</span></a><p>{{ t.footer }}</p></div>
 <div class="footer-links"><a href="{{ site.github }}">GitHub ↗</a><a href="{{ site.linkedin }}">LinkedIn ↗</a><a href="{{ t.prefix }}feed.xml">RSS ↗</a><span>© 2026 Yuyang Dong</span></div>
</footer>
</body>
</html>
