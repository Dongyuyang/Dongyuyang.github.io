<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">{% for t in locales %}{% for suffix in ['', 'blog/', 'publications/'] %}<url><loc>{{ (t.prefix + suffix) | absoluteUrl }}</loc></url>{% endfor %}{% endfor %}{% for post in collections.publishedPosts %}<url><loc>{{ post.url | absoluteUrl }}</loc></url>{% endfor %}</urlset>
