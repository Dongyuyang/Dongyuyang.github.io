<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Yuyang Dong — Blog &amp; Notes</title><link>{{ site.url }}/blog/</link><description>Research notes on data, models, and agents. English and Chinese.</description><atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml"/>{% for post in collections.publishedPosts %}<item><title>{{ post.data.title | xmlEscape | safe }}</title><link>{{ post.url | absoluteUrl }}</link><guid>{{ post.url | absoluteUrl }}</guid><description>{{ post.data.description | xmlEscape | safe }}</description><pubDate>{{ post.date.toUTCString() }}</pubDate></item>{% endfor %}</channel></rss>
