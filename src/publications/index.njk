---
layout: base.njk
pageKey: publications
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.prefix }}publications/"
---
{% set t = locale %}
<div class="wrap page-intro"><a class="back-link" href="{{ t.prefix }}">← {{ t.home }}</a><h1>{{ t.publications }}</h1><a class="text-link" href="{{ site.dblp }}">{{ t.dblp }} ↗</a></div>
<section class="wrap archive-section"><label class="search-box"><span>{{ t.findPaper }}</span><input id="paper-search" name="q" type="search" placeholder="{{ t.searchPlaceholder }}" autocomplete="off"></label><p class="small muted" id="paper-count" role="status" data-template="{{ t.paperCount }}" data-equal="{{ t.equal }}">{{ t.paperCount | replace('{count}', publications.length) | replace('{total}', publications.length) }} · {{ t.equal }}</p><div class="paper-list">
{% for p in publications %}<article class="paper-row archive-paper"><div class="paper-year">{{ p.year }}</div><div><h2>{{ p.title }}</h2><p>{{ p.authors }}</p><p class="paper-venue">{{ p.venue }}</p><div class="project-links">{% for link in p.links %}<a href="{{ link.url }}">{{ link.label | linkLabel(t.code) }} ↗</a>{% endfor %}</div></div></article>{% endfor %}
</div><p class="filter-empty" id="paper-empty" hidden>{{ t.paperEmpty }}</p></section>
