---
layout: base.njk
isHome: true
pageKey: home
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.prefix }}"
---
{% set t = locale %}
<section class="profile-top wrap" id="profile" aria-label="{{ t.profileLabel }}">
 <figure class="profile-photo"><img src="/photo.jpg" alt="{{ t.photoAlt }}" width="640" height="480" fetchpriority="high" decoding="async"></figure>
 <div class="profile-summary">
  <p class="eyebrow">{{ t.researcher }}</p>
  <p class="profile-name">Yuyang Dong <span>(David Dong)</span></p>
  <p class="profile-roles">{{ t.chief }}, SB Intuitions ({{ t.softbank }})<br>{{ t.osaka }} · {{ t.invited }}</p>
  {% include "social-links.njk" %}
 </div>
</section>
<section class="hero wrap" id="vision">
 <div class="hero-copy">
  <div class="eyebrow">{{ t.vision }}</div>
  <h1>{{ t.headline | safe }}</h1>
  <p class="hero-intro">{{ t.visionText }}</p>
  <div class="hero-actions"><a class="button primary" href="#research">{{ t.explore }} <span aria-hidden="true">↓</span></a></div>
 </div>
 <div class="research-visual" aria-label="{{ t.loopLabel }}">
  <div class="visual-top"><span class="micro">{{ t.loopTitle }}</span><span class="micro muted">01 — 03</span></div>
  <div class="network-stage">
   <svg class="network" viewBox="0 0 520 380" role="img" aria-label="{{ t.loopLabel }}">
    <defs><radialGradient id="halo"><stop stop-color="#e60012" stop-opacity=".15"/><stop offset="1" stop-color="#e60012" stop-opacity="0"/></radialGradient><linearGradient id="wire"><stop stop-color="#e60012" stop-opacity=".7"/><stop offset="1" stop-color="#ba0015" stop-opacity=".2"/></linearGradient></defs>
    <circle cx="262" cy="180" r="168" fill="url(#halo)"/>
    <g class="orbital-grid" fill="none" stroke="#e60012" stroke-opacity=".1"><ellipse cx="262" cy="180" rx="163" ry="144"/><ellipse cx="262" cy="180" rx="114" ry="144"/><ellipse cx="262" cy="180" rx="50" ry="144"/><ellipse cx="262" cy="180" rx="163" ry="92"/><ellipse cx="262" cy="180" rx="163" ry="37"/><path d="M99 180h326M262 36v288"/></g>
    <g id="network-points"></g>
    <g class="loop-tracks" fill="none" stroke="url(#wire)" stroke-width="1.2"><path d="M105 241Q96 112 255 96T423 241"/><path d="M423 241Q274 378 105 241"/><path d="M105 241L255 96L423 241Z" opacity=".35"/></g>
    <g class="moving-signal"><circle r="3" fill="#e60012"><animateMotion dur="4s" repeatCount="1" fill="freeze" path="M105 241Q96 112 255 96T423 241Q274 378 105 241"/></circle></g>
    <g class="graph-node node-data" transform="translate(105 241)"><circle class="node-halo" r="26"/><circle class="node-ring" r="16"/><rect x="-6" y="-6" width="12" height="12" rx="2"/><text x="0" y="46" text-anchor="middle" >{{ t.data }}</text></g>
    <g class="graph-node node-models" transform="translate(255 96)"><circle class="node-halo" r="29"/><circle class="node-ring" r="19"/><path d="M-8 0L0-8L8 0L0 8Z"/><text x="0" y="-37" text-anchor="middle">{{ t.models }}</text></g>
    <g class="graph-node node-agents" transform="translate(423 241)"><circle class="node-halo" r="26"/><circle class="node-ring" r="16"/><path d="M-6-6L7 0L-6 6Z"/><text x="0" y="46" text-anchor="middle">{{ t.agents }}</text></g>
    <text class="graph-caption" x="262" y="360" text-anchor="middle">{{ t.loopCaption }}</text>
   </svg>
  </div>
  <div class="loop-tabs" role="tablist" aria-label="{{ t.layers }}">
   <button role="tab" aria-selected="true" aria-controls="loop-panel" id="tab-data" data-layer="data" data-kicker="{{ t.dataKicker }}" data-description="{{ t.dataDescription }}" data-link="{{ t.dataLink }}" data-href="#data-research" tabindex="0"><span>01</span> {{ t.data }}</button>
   <button role="tab" aria-selected="false" aria-controls="loop-panel" id="tab-models" data-layer="models" data-kicker="{{ t.modelsKicker }}" data-description="{{ t.modelsDescription }}" data-link="{{ t.modelsLink }}" data-href="#models-research" tabindex="-1"><span>02</span> {{ t.models }}</button>
   <button role="tab" aria-selected="false" aria-controls="loop-panel" id="tab-agents" data-layer="agents" data-kicker="{{ t.agentsKicker }}" data-description="{{ t.agentsDescription }}" data-link="{{ t.agentsLink }}" data-href="{{ t.prefix }}blog/" tabindex="-1"><span>03</span> {{ t.agents }}</button>
  </div>
  <div class="loop-panel" id="loop-panel" role="tabpanel" aria-labelledby="tab-data" tabindex="0"><span class="micro accent" id="loop-kicker">{{ t.dataKicker }}</span><p id="loop-description">{{ t.dataDescription }}</p><a id="loop-link" href="#data-research">{{ t.dataLink }} <span aria-hidden="true">↗</span></a></div>
 </div>
</section>
<div class="credibility wrap"><span class="micro">{{ t.affiliations }}</span><div><span>SB Intuitions <small>{{ t.softbank }}</small></span><span>NEC <small>2019–2025</small></span><span>{{ t.osaka }}</span><span>{{ t.tsukuba }} <small>{{ t.phd }}</small></span></div></div>
<section class="section wrap" id="research">
 <div class="section-heading"><h2>{{ t.research }}</h2></div>
 <article class="flagship foundation-feature" id="models-research">
  <div class="flagship-copy">
   <div class="eyebrow accent">{{ t.foundation }}</div>
   <h3 class="foundation-title">{{ t.foundationTitle }}</h3>
   <p>{{ t.foundationBody | safe }}</p>
   <p>{{ t.foundationDetail }}</p>
  </div>
  <div class="foundation-models">
   <section class="foundation-model" aria-labelledby="sarashina-title">
    <p class="model-company">SB Intuitions · {{ t.softbank }}</p>
    <h4 id="sarashina-title">Sarashina3</h4>
    <p>{{ t.sarashinaDescription }}</p>
    <a class="text-link" href="https://www.sbintuitions.co.jp/blog/entry/2026/06/30/100000">{{ t.officialBlog }} <span aria-hidden="true">↗</span></a>
   </section>
   <section class="foundation-model" aria-labelledby="cotomi-title">
    <p class="model-company">NEC</p>
    <h4 id="cotomi-title">cotomi / cotomi-v2</h4>
    <p>{{ t.cotomiDescription }}</p>
    <a class="text-link" href="https://www.nec.com/en/global/rd/technologies/202310/index.html">{{ t.necInterview }} <span aria-hidden="true">↗</span></a>
   </section>
  </div>
 </article>
 <div class="research-grid">
  <article class="research-card" id="data-research"><div class="card-meta"><span class="micro accent">{{ t.dataTitle }}</span><span class="micro muted">01</span></div><div class="table-art" aria-hidden="true"><div><span></span><span></span><span></span><span></span></div><div><span></span><span class="highlight"></span><span></span><span></span></div><div><span></span><span></span><span class="highlight"></span><span></span></div><div><span class="highlight"></span><span></span><span></span><span></span></div><b>↗</b><div class="table-clean"><span></span><span></span><span></span><span></span></div></div><h3>{{ t.dataProjects }}</h3><p>{{ t.dataBody | safe }}</p><div class="project-links"><a href="https://aclanthology.org/2024.emnlp-main.497/">Jellyfish · EMNLP 2024 ↗</a><a href="https://arxiv.org/abs/2212.07588">DeepJoin · VLDB 2023 ↗</a></div></article>
  <article class="research-card"><div class="card-meta"><span class="micro accent">{{ t.multimodal }}</span><span class="micro muted">02</span></div><div class="document-art" aria-hidden="true"><div class="doc-page"><i></i><i></i><i></i><div class="doc-chart"><b></b><b></b><b></b><b></b></div><i></i></div><span class="scan-line"></span></div><h3>{{ t.scanTitle }}</h3><p>{{ t.scanBody | safe }}</p><div class="project-links"><a href="https://aclanthology.org/2026.findings-eacl.82/">SCAN · EACL 2026 ↗</a><a href="https://www.nec.com/en/press/202411/global_20241127_03.html">{{ t.necTechnology }} ↗</a></div></article>
 </div>
</section>
<section class="section papers-section" id="publications"><div class="wrap">
 <div class="section-heading"><h2>{{ t.publications }}</h2><a class="text-link" href="{{ t.prefix }}publications/">{{ t.allPapers }} <span aria-hidden="true">↗</span></a></div>
 <div class="paper-list">
 {% for p in publications %}{% if loop.index <= 4 %}<article class="paper-row"><div class="paper-year">{{ p.year }}</div><div><div class="micro accent">{% if p.title.startsWith('Adaptive') %}FINDINGS OF ACL{% elif p.title.startsWith('SCAN') %}FINDINGS OF EACL{% elif p.title.startsWith('Learning') %}ARXIV PREPRINT{% else %}EMNLP{% endif %}</div><h3><a href="{{ p.links[0].url }}">{{ p.title }} <span aria-hidden="true">↗</span></a></h3><p>{{ p.authors }}</p></div></article>{% endif %}{% endfor %}
 </div>
 <p class="small muted">{{ t.equal }}</p>
</div></section>
<section class="section wrap" id="news">
 <div class="section-heading"><h2>{{ t.blog }}</h2><a class="text-link" href="{{ t.prefix }}blog/">{{ t.visitBlog }} ↗</a></div>
 {% set entries = collections.publishedPosts | writingFor(t.code) %}
 {% include "writing-list.njk" %}
</section>
<section class="section about-section" id="about"><div class="wrap about-grid"><div><h2>{{ t.about }}</h2><a class="text-link" href="{{ site.linkedin }}">{{ t.connect }} ↗</a></div><div class="timeline"><article><span class="micro accent">{{ t.currentOsaka }}</span><h3>{{ t.osaka }}</h3><p>{{ t.invited }}</p></article><article><span class="micro accent">{{ t.currentSB }}</span><h3>SB Intuitions <small>({{ t.softbank }})</small></h3><p>{{ t.chief }}<br>{{ t.sarashinaWork }}</p></article><article><span class="micro muted">{{ t.pastNEC }}</span><h3>NEC Corporation</h3><p>{{ t.necRole }}<br>{{ t.necWork }}</p><a href="https://www.nec.com/en/global/rd/technologies/202310/index.html">{{ t.necInterview }} ↗</a></article><article><span class="micro muted">2014 — 2019</span><h3>{{ t.tsukuba }}</h3><p>{{ t.masters }}</p></article><article><span class="micro muted">2013</span><h3>{{ t.cumt }}</h3><p>{{ t.bachelor }}</p></article></div></div>
 <div class="wrap awards-strip" id="awards"><span class="micro">{{ t.awards }}</span><div><strong>{{ t.awardDB }}</strong><span>2022</span></div><div><strong>{{ t.awardTsukuba }}</strong><span>2019</span></div><div><strong>{{ t.awardDEXA }}</strong><span>2016</span></div></div>
</section>
