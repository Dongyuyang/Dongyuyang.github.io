---
layout: base.njk
pageKey: blog
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.prefix }}blog/"
---
{% set t = locale %}
<div class="wrap page-intro"><a class="back-link" href="{{ t.prefix }}">← {{ t.home }}</a><h1>{{ t.blog }}</h1></div>
<section class="wrap blog-body" aria-labelledby="notes-title"><div class="section-heading small-heading"><h2 id="notes-title">{{ t.elsewhere }}</h2><a class="text-link" href="{{ t.prefix }}feed.xml">{{ t.followRSS }} ↗</a></div>
{% set entries = collections.publishedPosts | writingFor(t.code) %}
{% if entries.length %}{% include "writing-list.njk" %}
{% else %}<p class="notebook-empty">{{ t.noPosts }}</p>{% endif %}
</section>
