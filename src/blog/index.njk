---
layout: base.njk
pageKey: blog
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.prefix }}blog/"
---
{% set t = locale %}
<div class="wrap page-intro"><a class="back-link" href="{{ t.prefix }}">← {{ t.home }}</a><h1>{{ t.blog }}</h1></div>
<section class="wrap blog-body" aria-labelledby="notes-title"><div class="section-heading small-heading"><h2 id="notes-title">{{ t.onSite }}</h2><a class="text-link" href="{{ t.prefix }}feed.xml">{{ t.followRSS }} ↗</a></div>
{% set entries = collections.publishedPosts | postsFor(t.code) %}
{% if entries.length %}<div class="writing-list">{% for post in entries %}<article class="writing-row post-item"><span class="micro">{{ post.date | readableDate(t.code) }}</span><div><h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3><p>{{ post.data.description }}</p></div><a href="{{ post.url }}" aria-label="{{ t.read }}: {{ post.data.title }}">↗</a></article>{% endfor %}</div>
{% else %}<p class="notebook-empty">{{ t.noPosts }}</p>{% endif %}
</section>
<section class="wrap section elsewhere"><h2>{{ t.elsewhere }}</h2>{% include "external-writing.njk" %}</section>
